// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS

enum EstadoCaso {
  PENDIENTE
  EN_PROCESO
  RESUELTO
  CANCELADO
}

enum TipoUsuario {
  ESTUDIANTE_PREGRADO
  ESTUDIANTE_POSGRADO
  DOCENTE
  ADMINISTRATIVO
  EGRESADO
  OTRO
}

// MODELS

model Usuario {
  id               Int         @id @default(autoincrement())
  nombres          String
  apellidos        String
  tipoDocumento    String
  numeroDocumento  String
  codigo           String?
  telefono         String
  email            String      @unique
  direccion        String?
  tipo             TipoUsuario
  casosPresentados Caso[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Caso {
  id                       Int             @id @default(autoincrement())
  expediente               String          @unique
  codigoSeguimiento        String          @unique
  estado                   EstadoCaso      @default(PENDIENTE)
  tipoVulneracion          String
  fechaHechos              DateTime
  lugarHechos              String?
  requiereAccion           Boolean
  aceptaTerminos           Boolean
  autorizaTratamientoDatos Boolean
  recurrenteId             Int
  recurrente               Usuario         @relation(fields: [recurrenteId], references: [id])
  denunciado               Denunciado?
  actualizaciones          Actualizacion[]
  documentos               Documento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Denunciado {
  id        Int     @id @default(autoincrement())
  nombres   String?
  apellidos String?
  cargoArea String?
  relacion  String
  casoId    Int     @unique
  caso      Caso    @relation(fields: [casoId], references: [id])
}

model Actualizacion {
  id          Int        @id @default(autoincrement())
  fecha       DateTime   @default(now())
  estado      EstadoCaso
  descripcion String
  detalle     String?
  casoId      Int
  caso        Caso       @relation(fields: [casoId], references: [id])
}

model Documento {
  id            Int      @id @default(autoincrement())
  nombreArchivo String
  url           String
  tipoMime      String
  size          Int
  casoId        Int
  caso          Caso     @relation(fields: [casoId], references: [id])
  uploadedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
